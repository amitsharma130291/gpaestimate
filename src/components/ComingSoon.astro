---
interface Props {
  heading: string;
  description: string;
}
const { heading, description } = Astro.props;
---

<main id="main-content" class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
  <h1 class="text-3xl font-bold text-graphite sm:text-4xl">{heading}</h1>
  <p class="mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-graphite-muted">
    {description}
  </p>
  <p class="mt-1 text-[15px] text-graphite-muted">
    This tool is on its way. In the meantime, the GPA Calculator below handles standard and
    cumulative GPA math today.
  </p>
  <a
    href="/"
    class="mt-6 inline-flex items-center justify-center rounded-pill bg-pine-900 px-5 py-2.5 text-[15px] font-semibold text-cream transition-colors duration-140 hover:bg-pine-800"
  >
    Go to GPA Calculator
  </a>
</main>
