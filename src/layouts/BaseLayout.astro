---
import "@/styles/global.css";
import SiteFooter from "@/components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown>;
  /** Set for thin/placeholder pages that shouldn't be indexed until they have real content. */
  noindex?: boolean;
  /** Path to a page-specific social preview image; falls back to the shared brand image. */
  image?: string;
}

const { title, description, structuredData, noindex = false, image = "/og-image.png" } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://gpaestimate.com");
const imageUrl = new URL(image, Astro.site ?? "https://gpaestimate.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="gpaestimate.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="gpaestimate.com — Live GPA, updated instantly" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {
      structuredData ? (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      ) : null
    }

    <noscript>
      <style>
        .reveal-on-scroll {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="min-h-screen bg-mist text-graphite">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-control focus:bg-pine-900 focus:px-4 focus:py-2 focus:text-cream"
    >
      Skip to main content
    </a>
    <slot />
    <SiteFooter />

    <script is:inline>
      (function () {
        const targets = document.querySelectorAll(".reveal-on-scroll");
        if (!targets.length) return;
        if (!("IntersectionObserver" in window)) {
          targets.forEach(function (el) {
            el.classList.add("is-visible");
          });
          return;
        }
        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
        );
        targets.forEach(function (el) {
          observer.observe(el);
        });
      })();
    </script>
  </body>
</html>
