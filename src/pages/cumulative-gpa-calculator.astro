---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CumulativeGpaTool } from "@/components/calculator/CumulativeGpaTool";
import { FaqAccordion, type FaqItem } from "@/components/calculator/FaqAccordion";

const FAQ_ITEMS: FaqItem[] = [
  {
    question: "Is cumulative GPA all 4 years?",
    answer:
      "Yes — cumulative GPA combines every semester or term you've completed into one running average, as opposed to a semester GPA, which only reflects a single term.",
  },
  {
    question: "Is a 2.5 cumulative GPA good?",
    answer:
      "A 2.5 is below average for competitive programs but is generally considered satisfactory academic standing at most schools. Whether it's \"good\" depends on your program's specific GPA requirements.",
  },
  {
    question: "Is a 3.4 cumulative GPA bad?",
    answer:
      "No — a 3.4 cumulative GPA is solidly in the \"strong\" range (a B+/A- average) and meets the typical GPA requirement for most graduate programs, honors societies, and scholarships.",
  },
  {
    question: "What is my cumulative GPA on a 4.0 scale?",
    answer:
      "Add up the quality points (GPA × credits) from every semester, then divide by your total credits across all semesters — that result is already on the same 4.0 scale as each individual semester GPA.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Cumulative GPA Calculator",
  url: "https://gpaestimate.com/cumulative-gpa-calculator/",
  applicationCategory: "EducationApplication",
  operatingSystem: "Any",
  description:
    "Combine every semester's GPA and credits into one cumulative GPA. Automatically loads any semesters you've saved on this device.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title="Cumulative GPA Calculator by Semester | gpaestimate.com"
  description="Combine every semester's GPA and credits into one cumulative GPA, updated instantly as you add terms."
  structuredData={structuredData}
>
  <CumulativeGpaTool currentPath="/cumulative-gpa-calculator" client:load />

  <div class="bg-porcelain">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqStructuredData)} />

    <section aria-labelledby="cumulative-how" class="reveal-on-scroll px-4 pt-12 sm:px-6 sm:pt-14 lg:px-10 lg:pt-16">
      <div class="mx-auto max-w-[820px]">
        <h2 id="cumulative-how" class="text-2xl font-bold text-graphite sm:text-3xl">
          How cumulative GPA is different from semester GPA
        </h2>
        <p class="mt-3 text-[15px] leading-relaxed text-graphite-muted">
          A semester GPA only reflects the courses you took in one term. Cumulative GPA weights
          every semester by its credit load and combines them into a single running average — so a
          strong semester "counts more" the more credits it carries, and one rough term rarely
          moves your cumulative number as much as it moved that semester's own GPA.
        </p>
        <div class="mt-6 rounded-panel border border-pine-800/15 bg-white px-6 py-6 text-center sm:py-8">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-graphite-muted">
            The formula
          </p>
          <p class="mt-3 text-xl font-semibold tracking-tight text-pine-900 sm:text-2xl">
            Cumulative GPA = Σ (semester GPA × semester credits) ÷ total credits
          </p>
        </div>
      </div>
    </section>

    <section aria-labelledby="cumulative-faq" class="reveal-on-scroll px-4 pt-12 sm:px-6 sm:pt-14 lg:px-10 lg:pt-16">
      <div class="mx-auto max-w-[820px]">
        <h2 id="cumulative-faq" class="text-2xl font-bold text-graphite sm:text-3xl">
          Frequently asked questions
        </h2>
        <div class="mt-6">
          <FaqAccordion items={FAQ_ITEMS} client:visible />
        </div>
      </div>
    </section>

    <section class="reveal-on-scroll px-4 pb-16 pt-12 sm:px-6 sm:pb-20 sm:pt-14 lg:px-10 lg:pb-24 lg:pt-16">
      <div class="mx-auto max-w-[820px] text-center">
        <a
          href="/"
          class="font-medium text-pine-800 underline decoration-pine-800/30 underline-offset-2 hover:text-pine-900"
        >
          Don't have a semester saved yet? Calculate one and save it →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
