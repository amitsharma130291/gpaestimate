---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { FinalGradeTool } from "@/components/calculator/FinalGradeTool";
import { FaqAccordion, type FaqItem } from "@/components/calculator/FaqAccordion";

const FAQ_ITEMS: FaqItem[] = [
  {
    question: "How do I find my final exam's weight?",
    answer:
      "Check your course syllabus — instructors almost always list how much each component (homework, midterms, final exam) counts toward your overall grade, usually as a percentage.",
  },
  {
    question: "What if I don't know my current grade?",
    answer:
      "Estimate it from your gradebook: average your scores so far, weighted by each assignment's share of the grade if your class uses that system. Many schools' online portals show a running current grade directly.",
  },
  {
    question: "What does it mean if the needed score is above 100%?",
    answer:
      "It means the target grade isn't reachable through the final exam alone under the given weighting — you'd need extra credit, a grade replacement policy, or a lower target to close the gap.",
  },
  {
    question: "Does this work for finals worth 100% of the grade?",
    answer:
      "Yes — set the weight to 100 and the calculator will tell you that you need to score exactly your desired final grade on the exam, since nothing else factors in.",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Final Grade Calculator",
  url: "https://gpaestimate.com/final-grade-calculator/",
  applicationCategory: "EducationApplication",
  operatingSystem: "Any",
  description:
    "Find the score you need on your final exam to reach a target overall course grade, based on your current grade and the exam's weight.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title="Final Grade Calculator (Exam Score) | gpaestimate.com"
  description="Find the score you need on your final exam to reach a target overall course grade, instantly."
  structuredData={structuredData}
>
  <FinalGradeTool currentPath="/final-grade-calculator" client:load />

  <div class="bg-porcelain">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqStructuredData)} />

    <section aria-labelledby="how-to-use-final-grade" class="reveal-on-scroll px-4 pt-12 sm:px-6 sm:pt-14 lg:px-10 lg:pt-16">
      <div class="mx-auto max-w-[820px]">
        <h2 id="how-to-use-final-grade" class="text-2xl font-bold text-graphite sm:text-3xl">
          How to use the Final Grade Calculator
        </h2>
        <p class="mt-3 text-[15px] leading-relaxed text-graphite-muted">
          Three numbers are all it takes: where your grade stands today, where you want it to
          land, and how much the final counts for.
        </p>
        <ol class="mt-6 space-y-4">
          <li class="flex gap-4 rounded-card border border-border bg-white p-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-pine-900 text-sm font-semibold text-cream">1</span>
            <div>
              <p class="font-semibold text-graphite">Enter your current grade</p>
              <p class="mt-1 text-sm text-graphite-muted">
                This is everything before the final — homework, quizzes, midterms — averaged
                together as a percentage. Most schools' online portals show this as a running
                grade.
              </p>
            </div>
          </li>
          <li class="flex gap-4 rounded-card border border-border bg-white p-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-pine-900 text-sm font-semibold text-cream">2</span>
            <div>
              <p class="font-semibold text-graphite">Enter the grade you want overall</p>
              <p class="mt-1 text-sm text-graphite-muted">
                A specific letter-grade cutoff (90% for an A−, for example), or whatever you're
                aiming for.
              </p>
            </div>
          </li>
          <li class="flex gap-4 rounded-card border border-border bg-white p-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-pine-900 text-sm font-semibold text-cream">3</span>
            <div>
              <p class="font-semibold text-graphite">Enter the final exam's weight</p>
              <p class="mt-1 text-sm text-graphite-muted">
                Check your syllabus — instructors almost always list how much each component
                counts toward the overall grade.
              </p>
            </div>
          </li>
        </ol>
        <div class="mt-6 rounded-panel border border-pine-800/15 bg-white px-6 py-6 sm:py-8">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-graphite-muted">
            Worked example
          </p>
          <p class="mt-3 text-[15px] leading-relaxed text-graphite-muted">
            Sitting at an 88% overall, aiming for a 90%, with the final worth 30% of the grade:{" "}
            <strong class="text-pine-900">(90 − 88 × 0.7) ÷ 0.3 = 94.7%</strong> needed on the
            exam. Change the exam weight to 50% instead and the required score drops to{" "}
            <strong class="text-pine-900">92%</strong> — a heavier final gives you more room to
            move the overall grade.
          </p>
        </div>
      </div>
    </section>

    <section aria-labelledby="final-grade-faq" class="reveal-on-scroll px-4 pt-12 sm:px-6 sm:pt-14 lg:px-10 lg:pt-16">
      <div class="mx-auto max-w-[820px]">
        <h2 id="final-grade-faq" class="text-2xl font-bold text-graphite sm:text-3xl">
          Frequently asked questions
        </h2>
        <div class="mt-6">
          <FaqAccordion items={FAQ_ITEMS} client:visible />
        </div>
      </div>
    </section>

    <section class="reveal-on-scroll px-4 pb-16 pt-12 sm:px-6 sm:pb-20 sm:pt-14 lg:px-10 lg:pb-24 lg:pt-16">
      <div class="mx-auto max-w-[820px] text-center">
        <a
          href="/"
          class="font-medium text-pine-800 underline decoration-pine-800/30 underline-offset-2 hover:text-pine-900"
        >
          Once your final grade is in, see how it affects your GPA →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
