---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StaticSiteHeader from "@/components/StaticSiteHeader.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
---

<BaseLayout
  title="Contact | gpaestimate.com"
  description="Get in touch with gpaestimate.com."
>
  <StaticSiteHeader currentPath="/contact" />
  <Breadcrumbs items={[{ label: "GPA Calculator", href: "/" }, { label: "Contact" }]} />
  <main id="main-content" class="mx-auto max-w-2xl px-4 py-14 sm:px-6">
    <h1 class="text-3xl font-bold text-graphite sm:text-4xl">Contact</h1>
    <p class="mt-4 text-[15px] leading-relaxed text-graphite-muted">
      Spotted an incorrect grading scale, a calculation issue, or have a suggestion? Send a
      message below and we'll get back to you.
    </p>

    <div
      id="contact-status"
      role="status"
      aria-live="polite"
      class="mt-6 hidden rounded-control border px-4 py-3 text-sm"
    >
    </div>

    <form id="contact-form" method="POST" action="/api/contact" class="mt-6 space-y-4" novalidate>
      <div>
        <label for="contact-name" class="block text-sm font-medium text-graphite">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          required
          autocomplete="name"
          class="mt-1.5 w-full rounded-control border border-border bg-white px-3 py-2 text-[15px] text-graphite transition-colors duration-140 focus:border-pine-700 focus:outline-none"
        />
      </div>

      <div>
        <label for="contact-email" class="block text-sm font-medium text-graphite">Email</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          class="mt-1.5 w-full rounded-control border border-border bg-white px-3 py-2 text-[15px] text-graphite transition-colors duration-140 focus:border-pine-700 focus:outline-none"
        />
      </div>

      <div>
        <label for="contact-subject" class="block text-sm font-medium text-graphite">Subject</label>
        <input
          id="contact-subject"
          name="subject"
          type="text"
          required
          class="mt-1.5 w-full rounded-control border border-border bg-white px-3 py-2 text-[15px] text-graphite transition-colors duration-140 focus:border-pine-700 focus:outline-none"
        />
      </div>

      <div>
        <label for="contact-message" class="block text-sm font-medium text-graphite">Message</label>
        <textarea
          id="contact-message"
          name="message"
          rows="6"
          required
          class="mt-1.5 w-full resize-y rounded-control border border-border bg-white px-3 py-2 text-[15px] text-graphite transition-colors duration-140 focus:border-pine-700 focus:outline-none"
        ></textarea>
      </div>

      <!-- Honeypot: hidden from sighted users and keyboard tab order, spam bots fill it anyway. -->
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <label for="contact-company">Company</label>
        <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-pill bg-pine-900 px-5 py-2.5 text-[15px] font-semibold text-cream transition-colors duration-140 hover:bg-pine-800 disabled:cursor-not-allowed disabled:opacity-60"
      >
        Send message
      </button>
    </form>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("contact-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!statusEl) return;

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    submitButton?.setAttribute("disabled", "true");
    statusEl.classList.remove("hidden", "border-terracotta-border", "bg-terracotta-bg", "text-terracotta-text");
    statusEl.classList.add("border-border", "bg-mist", "text-graphite-muted");
    statusEl.textContent = "Sending…";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        headers: { accept: "application/json" },
        body: new FormData(form),
      });
      const result = await response.json();

      if (!response.ok || result.error) {
        throw new Error(result.error || "Something went wrong sending your message.");
      }

      statusEl.classList.remove("border-border", "bg-mist", "text-graphite-muted");
      statusEl.classList.add("border-pine-700/30", "bg-pine-900/5", "text-pine-900");
      statusEl.textContent = "Thanks — your message has been sent. We'll get back to you soon.";
      form.reset();
    } catch (err) {
      statusEl.classList.remove("border-border", "bg-mist", "text-graphite-muted");
      statusEl.classList.add("border-terracotta-border", "bg-terracotta-bg", "text-terracotta-text");
      statusEl.textContent = err instanceof Error ? err.message : "Something went wrong sending your message.";
    } finally {
      submitButton?.removeAttribute("disabled");
    }
  });
</script>
