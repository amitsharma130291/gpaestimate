---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StaticSiteHeader from "@/components/StaticSiteHeader.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
---

<BaseLayout
  title="Contact | gpaestimate.com"
  description="Get in touch with gpaestimate.com."
>
  <StaticSiteHeader currentPath="/contact" />
  <Breadcrumbs items={[{ label: "GPA Calculator", href: "/" }, { label: "Contact" }]} />
  <main id="main-content" class="mx-auto max-w-2xl px-4 py-14 sm:px-6">
    <h1 class="text-3xl font-bold text-graphite sm:text-4xl">Contact</h1>
    <p class="mt-4 text-[15px] leading-relaxed text-graphite-muted">
      Spotted an incorrect grading scale, a calculation issue, or have a suggestion? Reach out at
      <a href="mailto:hello@gpaestimate.com" class="font-medium text-pine-800 underline decoration-pine-800/30 underline-offset-2 hover:text-pine-900">
        hello@gpaestimate.com
      </a>.
    </p>
  </main>
</BaseLayout>
